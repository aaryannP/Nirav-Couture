# ==============================================================================
# ERA43 Production Environment Configuration
# Copy this file to .env.local for development or configure in your deployment host
# ==============================================================================

# Mandatory Cryptographic Session Secret (Min 32 characters, HMAC-SHA256)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_64_byte_hex_string_in_production

# PostgreSQL Database Connection String (Mandatory for production persistence)
# Example: postgresql://username:password@hostname:5432/era43_db?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# Razorpay Online Payment Integration (Optional for live payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
